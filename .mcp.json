{
  "mcpServers": {
    "playwright": {
      "command": "pnpm",
      "args": [
        "exec",
        "playwright-mcp",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--no-sandbox",
        "--viewport-size",
        "1280x800",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
